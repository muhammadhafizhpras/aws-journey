aws_region          = "ap-southeast-3"
project_name        = "ec2-porto"
environment         = "dev"
key_name            = "aws_journey_ec2"
vpc_cidr            = "10.0.0.0/16"
enable_nat_gateway  = true
single_nat_gateway  = true

public_subnet = {
    "public-a" = { cidr_block = "10.0.10.0/24", az = "ap-southeast-3a" }
    "public-b" = { cidr_block = "10.0.20.0/24", az = "ap-southeast-3b" }
    "public-c" = { cidr_block = "10.0.30.0/24", az = "ap-southeast-3c" }
}

private_subnet = {
    "private-a" = { cidr_block = "10.0.1.0/24", az = "ap-southeast-3a" }
    "private-b" = { cidr_block = "10.0.2.0/24", az = "ap-southeast-3b" }
    "private-c" = { cidr_block = "10.0.3.0/24", az = "ap-southeast-3c" }
}

security_group = [ 
 {
  description = "Allow SSH"
  from_port = 22
  to_port = 22
  protocol = "tcp"
  cidr_blocks = [ "0.0.0.0/0" ]# Better from your ip device
 } 
]

ec2_instance = {
  web = {
    instance_type = "t3.micro"
    subnet_type   = "public"
    public_ip     =  true
    role          = "Frontend Web Server"
    key_name      = "frontend-key"
  }
  app = {
      instance_type = "t3.micro"
      public_ip     =  false
      subnet_type   = "private"
      role          = "Backend API Server"
      key_name      = "backend-key"
  }
  database = {
      instance_type = "t3.micro"
      public_ip     =  false
      subnet_type   = "private"
      role          = "Database Server"
      key_name      = "database-key"
  }   
}